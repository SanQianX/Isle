{
  "name": "isle",
  "version": "1.0.0",
  "private": true,
  "description": "ISLE 屿集 — 以地点为中心的旅行照片榜单",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:test": "node scripts/start-test-server.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "tsx scripts/seed.ts",
    "fixtures:generate": "node scripts/generate-test-fixtures.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e-isolated.mjs",
    "test:e2e:chromium": "node scripts/run-e2e-isolated.mjs --project=chromium",
    "test:e2e:firefox": "node scripts/run-e2e-isolated.mjs --project=firefox",
    "test:e2e:webkit": "node scripts/run-e2e-isolated.mjs --project=webkit",
    "test:visual": "node scripts/run-e2e-isolated.mjs --grep=@visual",
    "test:a11y": "node scripts/run-e2e-isolated.mjs --grep=@a11y",
    "check:all": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build && npm run test:e2e && npm run test:visual"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "busboy": "1.6.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "postcss": "8.5.30",
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/busboy": "1.5.5",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
