# --- ISLE runtime configuration (copy to .env for local development) --------
# NEVER commit a real .env. Values below are the documented defaults from
# DEPLOY_RUNBOOK §3; every one of them is read and validated by
# src/lib/config.ts, which aborts startup on missing/invalid values rather than
# silently falling back to a project-local database.

# development | test | production
NODE_ENV=development

# Absolute SQLite path. Must be a file: URL pointing at an absolute path.
DATABASE_URL=file:/var/lib/isle/db/isle.db

# Media layout (DATA_API_STORAGE §4.3):
#   MEDIA_ROOT/original/<aa>/<opaque-id>.<ext>
#   MEDIA_ROOT/preview/400/<aa>/<opaque-id>.webp
#   MEDIA_ROOT/preview/1200/<aa>/<opaque-id>.webp
MEDIA_ROOT=/var/lib/isle/media
UPLOAD_TMP_DIR=/var/lib/isle/tmp

# Public origin. Decides the visitor cookie prefix: https => __Host-isle_visitor.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Upload limits — shared by the API, the UI copy, nginx and the tests.
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=30
MAX_CONCURRENT_UPLOADS_PER_CLIENT=2
MAX_IMAGE_PIXELS=100000000

# friends-only expects an upstream gateway (nginx basic auth) to limit access.
SITE_ACCESS_MODE=friends-only

# Optional: pin the place shown on `/`. Defaults to the oldest place.
# FEATURED_PLACE_SLUG=guishan-island

# Refuse new uploads above this fraction of media volume used.
MEDIA_DISK_HIGH_WATERMARK=0.9

# Visitor cookie lifetime in seconds (~365 days).
VISITOR_COOKIE_MAX_AGE=31536000
